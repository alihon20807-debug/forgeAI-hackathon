# ClaimGuard environment — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real secrets. Only key *names* live here.

# --- PRISM tracing ---------------------------------------------------------
# Host + project id are non-secret config (also the defaults in app/config.py).
# The API key is a SECRET: leave it blank here; set the real value only in .env.
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
PRISMTRACE_PROJECT_ID=066e7755-d375-4690-b4a7-4492d33f680b
PRISMTRACE_API_KEY=

# Stable PRISM agent identity (guardrails/alerts are scoped to AGENT_ID;
# AGENT_NAME is display-only).
AGENT_ID=roadside-claimguard
AGENT_NAME=ClaimGuard FNOL Agent

# --- LLM inference (llama-server / LiteLLM / OpenAI-compatible) ------------
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=local-model
# Set true to run the deterministic offline agent (no external LLM needed).
USE_MOCK_LLM=false
